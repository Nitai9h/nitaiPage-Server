## 鉴权方式: pairing（默认，推荐）或 password
AUTH_MODE=pairing

## AUTH_MODE=password 时：
#   APP_PASSWORD_HASH  请使用 `npm run hash-password` 生成
#   APP_PASSWORD 设置密码（修改密码后所有设备都要重新验证）
APP_PASSWORD_HASH=
APP_PASSWORD=
# 口令模式下 API 端口只认这个静态令牌（配对模式下用不到，凭证由配对签发）
API_TOKEN=
# 会话有效期（秒），默认 30 天
SESSION_MAX_AGE=2592000
# 登录失败限流：窗口内最多失败次数 / 窗口长度（毫秒）
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MS=900000

# 前端
WEB_PORT=11123
# API
API_PORT=11125
HOST=0.0.0.0 # （仅本机则填 127.0.0.1 ）

# 数据目录
DATA_DIR=./data
# DB_PATH=./data/nitaiPage.sqlite
# FILES_DIR=./data/files

# AUTH_MODE=pairing 时：
# 配对码多久作废（毫秒），默认 10 分钟
PAIRING_TTL=600000
# 同时最多存在的待批准设备个数
MAX_PENDING_PAIRINGS=20
# 一次授权凭证能使用的时间（秒），默认 180 天
DEVICE_TOKEN_MAX_AGE=15552000

## 前端
# 前端目录，产物 PUBLIC_DIR = FRONTEND_DIR/dist （默认）
FRONTEND_DIR=./frontend
# PUBLIC_DIR=./frontend/dist
FRONTEND_REPO=https://github.com/Nitai9h/nitaipage
# 指定前端版本，改动后自动重建
FRONTEND_REF=v3.0.2
# false 则跳过构建
PREPARE_FRONTEND=true
##以下项目改动后会自动重建
# true 则锁定数据库存储
ONLY_SERVER=false
# 指定 api 地址，同源不用填
SERVER_URL=

## 限额
# 请求体上限（byte），插件源码会走 db 接口，默认 32MB
MAX_BODY_BYTES=33554432
# 单个上传文件上限（byte），默认 200MB
MAX_UPLOAD_BYTES=209715200

# kv 单条值的上限（byte）【超过只警告，大文件应走 /api/files】
MAX_VALUE_WARN_BYTES=262144
